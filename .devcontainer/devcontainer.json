{
  "name": "CoChem-BASE dashboard",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "COCHEM_ARTIFACT_DIR": "/home/vscode/CoChem_Artifacts",
    "QT_QPA_PLATFORM": "offscreen",
    "COCHEM_HEADLESS": "1",
    "OMP_NUM_THREADS": "2",
    "OPENBLAS_NUM_THREADS": "2",
    "COCHEM_CALCULATION_ENVIRONMENT": "github-actions"
  },
  "mounts": [
    "source=cochem-base-artifacts,target=/home/vscode/CoChem_Artifacts,type=volume"
  ],
  "postCreateCommand": "bash scripts/setup_devcontainer.sh",
  "postStartCommand": "python3 scripts/hosted_dashboard.py start --calculation-environment github-actions",
  "forwardPorts": [
    8866,
    8501,
    8888
  ],
  "portsAttributes": {
    "8866": {
      "label": "CoChem Voil\u00e0 dashboard",
      "onAutoForward": "notify",
      "protocol": "http"
    },
    "8501": {
      "label": "CoChem TOPOS complete interface",
      "onAutoForward": "notify",
      "protocol": "http"
    },
    "8888": {
      "label": "CoChem TORQ student interface",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/CoChem_Artifacts/ui-env/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "-c",
          "pytest-srs.ini"
        ]
      }
    },
    "codespaces": {
      "repositories": {
        "ProfJJK-CoChem/CoChem-ORCA": {
          "permissions": {
            "contents": "read"
          }
        },
        "ProfJJK-CoChem/CoChem-CFOUR": {
          "permissions": {
            "contents": "read"
          }
        },
        "ProfJJK-CoChem/CoChem-TOPOS": {
          "permissions": {
            "contents": "read"
          }
        },
        "ProfJJK-CoChem/CoChem-TORQ": {
          "permissions": {
            "contents": "read"
          }
        }
      }
    }
  }
}
