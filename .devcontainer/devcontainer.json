{
  "name": "CoChem-BASE dashboard",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "containerEnv": {
    "COCHEM_ARTIFACT_DIR": "/home/vscode/CoChem_Artifacts",
    "QT_QPA_PLATFORM": "offscreen",
    "COCHEM_HEADLESS": "1",
    "OMP_NUM_THREADS": "2",
    "OPENBLAS_NUM_THREADS": "2"
  },
  "mounts": [
    "source=cochem-base-artifacts,target=/home/vscode/CoChem_Artifacts,type=volume"
  ],
  "postCreateCommand": "sudo chown vscode:vscode /home/vscode/CoChem_Artifacts && python3 scripts/hosted_dashboard.py setup --min-disk-space-gb 1",
  "postStartCommand": "python3 scripts/hosted_dashboard.py start",
  "forwardPorts": [8866],
  "portsAttributes": {
    "8866": {
      "label": "CoChem Voilà dashboard",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "ms-toolsai.jupyter", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/CoChem_Artifacts/ui-env/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["-c", "pytest-srs.ini"]
      }
    },
    "codespaces": {
      "repositories": {
        "ProfJJK-CoChem/CoChem-TOPOS": {
          "permissions": {
            "contents": "read"
          }
        },
        "ProfJJK-CoChem/CoChem-TORQ": {
          "permissions": {
            "contents": "read"
          }
        }
      }
    }
  }
}
