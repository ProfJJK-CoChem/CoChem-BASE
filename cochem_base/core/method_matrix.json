{
    "$defs": {
        "ConcurrencyTag": {
            "enum": [
                "C",
                "G",
                "P",
                "S"
            ],
            "title": "ConcurrencyTag",
            "type": "string"
        },
        "FrozenMonomerFlag": {
            "enum": [
                "relaxed",
                "frozen-iso",
                "frozen-inc"
            ],
            "title": "FrozenMonomerFlag",
            "type": "string"
        },
        "ProductClassConfig": {
            "properties": {
                "product_class": {
                    "$ref": "#/$defs/ProductClassEnum"
                },
                "target_accuracy_b0_percent": {
                    "description": "B0 target accuracy percentage",
                    "title": "Target Accuracy B0 Percent",
                    "type": "number"
                },
                "search_window_12ghz_mhz": {
                    "description": "Search window width at 12 GHz",
                    "title": "Search Window 12Ghz Mhz",
                    "type": "number"
                },
                "mandatory_spend_priority": {
                    "description": "Ordered list of compute spend priorities (\u00a73.3)",
                    "items": {
                        "type": "string"
                    },
                    "title": "Mandatory Spend Priority",
                    "type": "array"
                }
            },
            "required": [
                "product_class",
                "target_accuracy_b0_percent",
                "search_window_12ghz_mhz",
                "mandatory_spend_priority"
            ],
            "title": "ProductClassConfig",
            "type": "object"
        },
        "ProductClassEnum": {
            "enum": [
                "Product_A_DeNovo",
                "Product_B_SemiExperimental",
                "Product_C_Differences"
            ],
            "title": "ProductClassEnum",
            "type": "string"
        },
        "TierRowConfig": {
            "properties": {
                "tier_id": {
                    "description": "Tier ID string, e.g., T3O-12h",
                    "title": "Tier Id",
                    "type": "string"
                },
                "category": {
                    "description": "T1 (Search), T2 (PES), T3 (Geom), T4 (Vib), T5 (Interaction)",
                    "title": "Category",
                    "type": "string"
                },
                "walltime_seconds": {
                    "description": "Wall-clock budget in seconds",
                    "title": "Walltime Seconds",
                    "type": "integer"
                },
                "method_string": {
                    "description": "Exact electronic structure method keyword",
                    "title": "Method String",
                    "type": "string"
                },
                "basis_set": {
                    "description": "Primary orbital basis set",
                    "title": "Basis Set",
                    "type": "string"
                },
                "auxiliary_basis": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Auxiliary fitting basis set",
                    "title": "Auxiliary Basis"
                },
                "accuracy_window_mhz": {
                    "additionalProperties": {
                        "type": "number"
                    },
                    "description": "Target search window at 12 GHz",
                    "title": "Accuracy Window Mhz",
                    "type": "object"
                },
                "concurrency_tags": {
                    "description": "Resource concurrency classification",
                    "items": {
                        "$ref": "#/$defs/ConcurrencyTag"
                    },
                    "title": "Concurrency Tags",
                    "type": "array"
                },
                "state_in_dependencies": {
                    "description": "Required input states",
                    "items": {
                        "type": "string"
                    },
                    "title": "State In Dependencies",
                    "type": "array"
                },
                "state_out_artifacts": {
                    "description": "Emitted state artifacts",
                    "items": {
                        "type": "string"
                    },
                    "title": "State Out Artifacts",
                    "type": "array"
                },
                "frozen_monomer_mode": {
                    "$ref": "#/$defs/FrozenMonomerFlag",
                    "default": "relaxed",
                    "description": "Frozen-monomer mode"
                },
                "provenance_tag": {
                    "description": "[M], [D], or [E] tag for accuracy claim",
                    "title": "Provenance Tag",
                    "type": "string"
                }
            },
            "required": [
                "tier_id",
                "category",
                "walltime_seconds",
                "method_string",
                "basis_set",
                "accuracy_window_mhz",
                "concurrency_tags",
                "provenance_tag"
            ],
            "title": "TierRowConfig",
            "type": "object"
        }
    },
    "properties": {
        "version": {
            "default": "4.0.0",
            "description": "Method Matrix specification version",
            "title": "Version",
            "type": "string"
        },
        "product_classes": {
            "additionalProperties": {
                "$ref": "#/$defs/ProductClassConfig"
            },
            "title": "Product Classes",
            "type": "object"
        },
        "tier_rows": {
            "additionalProperties": {
                "$ref": "#/$defs/TierRowConfig"
            },
            "title": "Tier Rows",
            "type": "object"
        },
        "concurrency_guards": {
            "additionalProperties": {
                "type": "boolean"
            },
            "title": "Concurrency Guards",
            "type": "object"
        }
    },
    "title": "MethodMatrixV4",
    "type": "object"
}