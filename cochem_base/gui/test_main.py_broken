"""Tests for CoChem-Studio GUI Entrypoint and CLI Bootstrap (main.py)."""

from __future__ import annotations

import json
from pathlib import Path

import pytest
from PySide6.QtCore import QTimer
from PySide6.QtWidgets import QApplication

from cochem_base.gui.main import (
    APPLICATION_DISPLAY_NAME,
    APPLICATION_NAME,
    APPLICATION_VERSION,
    ORGANIZATION_DOMAIN,
    ORGANIZATION_NAME,
    apply_theme,
    build_argument_parser,
    configure_logging,
    create_application,
    load_workspace_state,
    main,
    setup_application_metadata,
    setup_exception_hook,
    setup_signal_handling,
)
from cochem_base.gui.main_window import MainWindow, WorkspaceState


@pytest.fixture(scope="session")
def qapp() -> QApplication:
    """Ensure QApplication instance is initialized for GUI tests."""
    app = QApplication.instance()
    if app is None:
        app = QApplication([])
    return app


def test_build_argument_parser() -> None:
    """Verify CLI argument parser configuration and flag options."""
    parser = build_argument_parser()

    # Default options
    args = parser.parse_args([])
    assert args.workspace is None
    assert args.config is None
    assert args.verbose is False
    assert args.dry_run is False
    assert args.log_file is None
    assert args.theme is None

    # Explicit options
    args = parser.parse_args(
        [
            "--workspace",
            "my_workspace.json",
            "--config",
            "custom_config.json",
            "--verbose",
            "--dry-run",
            "--log-file",
            "app.log",
            "--theme",
            "dark",
        ]
    )
    assert args.workspace == "my_workspace.json"
    assert args.config == "custom_config.json"
    assert args.verbose is True
    assert args.dry_run is True
    assert args.log_file == "app.log"
    assert args.theme == "dark"

    # Short options
    args_short = parser.parse_args(["-w", "ws.json", "-c", "cfg.json", "-v"])
    assert args_short.workspace == "ws.json"
    assert args_short.config == "cfg.json"
    assert args_short.verbose is True


def test_setup_application_metadata(qapp: QApplication) -> None:
    """Verify Qt application metadata configuration."""
    setup_application_metadata(qapp)
    assert qapp.applicationName() == "CoChem-Studio"
    assert qapp.applicationDisplayName() == "CoChem-Studio"
    assert qapp.applicationVersion() == "0.1.0"
    assert qapp.organizationName() == "CoChem"
    assert qapp.organizationDomain() == "cochem.org"


def test_create_application(qapp: QApplication) -> None:
    """Verify create_application helper reuses or initializes QApplication and sets metadata."""
    app = create_application(["--test"])
    assert app is not None
    assert isinstance(app, QApplication)
    assert app.applicationName() == "CoChem-Studio"


def test_setup_signal_handling(qapp: QApplication) -> None:
    """Verify signal handling timer creation."""
    timer = setup_signal_handling(qapp)
    assert isinstance(timer, QTimer)
    assert timer.isActive()
    assert timer.interval() == 500


def test_setup_exception_hook(qapp: QApplication) -> None:
    """Verify global uncaught exception hook installation and fallback window logging."""
    import sys

    orig_hook = sys.excepthook
    setup_exception_hook()
    assert sys.excepthook is not orig_hook

    # Test exception handler dispatching
    window = MainWindow()
    window.show()
    try:
        sys.excepthook(RuntimeError, RuntimeError("Test exception hook"), None)
    finally:
        window.close()
        sys.excepthook = orig_hook


def test_configure_logging(tmp_path: Path) -> None:
    """Verify logging configuration with verbose, normal modes, and file logging."""
    import logging

    # 1. Verbose mode
    configure_logging(verbose=True)
    assert logging.getLogger("cochem_base.gui.main").getEffectiveLevel() == logging.DEBUG

    # 2. Non-verbose mode
    configure_logging(verbose=False)
    assert logging.getLogger("cochem_base.gui.main").getEffectiveLevel() == logging.INFO

    # 3. File logging
    log_file = tmp_path / "logs" / "test_run.log"
    configure_logging(verbose=True, log_file=log_file)
    test_logger = logging.getLogger("cochem_base.gui.main")
    test_logger.info("Structured log line written to file.")
    assert log_file.is_file()
    content = log_file.read_text(encoding="utf-8")
    assert "Structured log line written to file." in content


def test_load_workspace_state(qapp: QApplication, tmp_path: Path) -> None:
    """Verify safe workspace preloading and tab switching."""
    window = MainWindow()

    # 1. Non-existent file
    assert load_workspace_state(window, tmp_path / "non_existent.json") is False

    # 2. Corrupted JSON
    bad_json = tmp_path / "bad.json"
    bad_json.write_text("{corrupt json content", encoding="utf-8")
    assert load_workspace_state(window, bad_json) is False

    # 3. Invalid schema
    invalid_schema = tmp_path / "invalid_schema.json"
    invalid_schema.write_text(json.dumps({"unexpected_field": 123}), encoding="utf-8")
    assert load_workspace_state(window, invalid_schema) is False

    # 4. Valid workspace state
    valid_file = tmp_path / "valid_workspace.json"
    valid_state = WorkspaceState(
        version="1.0",
        cochem_base="active",
        tabs=[window.tabs.tabText(i) for i in range(window.tabs.count())],
        active_tab_index=1,
    )
    valid_file.write_text(valid_state.model_dump_json(indent=2), encoding="utf-8")

    assert load_workspace_state(window, valid_file) is True
    assert window.tabs.currentIndex() == 1


def test_main_dry_run(qapp: QApplication) -> None:
    """Verify that --dry-run initializes all subsystems and returns exit code 0."""
    exit_code = main(["--dry-run", "--verbose"])
    assert exit_code == 0


def test_main_dry_run_with_valid_workspace(qapp: QApplication, tmp_path: Path) -> None:
    """Verify that --dry-run with a workspace preloads successfully."""
    window = MainWindow()
    ws_file = tmp_path / "test_ws.json"
    state = WorkspaceState(
        version="1.0",
        cochem_base="active",
        tabs=[window.tabs.tabText(i) for i in range(window.tabs.count())],
        active_tab_index=2,
    )
    ws_file.write_text(state.model_dump_json(), encoding="utf-8")

    exit_code = main(["--dry-run", "-w", str(ws_file)])
    assert exit_code == 0


def test_main_dry_run_with_missing_workspace(qapp: QApplication, tmp_path: Path) -> None:
    """Verify that --dry-run with missing workspace logs warning but completes gracefully."""
    missing_ws = tmp_path / "nonexistent_ws.json"
    exit_code = main(["--dry-run", "-w", str(missing_ws)])
    assert exit_code == 0


def test_main_with_invalid_config(tmp_path: Path) -> None:
    """Verify that main returns non-zero exit code when given a missing config."""
    missing_cfg = tmp_path / "nonexistent_cfg.json"
    exit_code = main(["--dry-run", "-c", str(missing_cfg)])
    assert exit_code == 1


def test_main_version_flag() -> None:
    """Verify that --version exits cleanly with code 0."""
    exit_code = main(["--version"])
    assert exit_code == 0


def test_main_help_flag() -> None:
    """Verify that --help exits cleanly with code 0."""
    exit_code = main(["--help"])
    assert exit_code == 0


def test_apply_theme(qapp: QApplication) -> None:
    """Verify theme application helper for various presets and fallbacks."""
    # 1. None and empty theme
    apply_theme(qapp, None)
    apply_theme(qapp, "")

    # 2. Qt built-in style
    apply_theme(qapp, "Fusion")
    apply_theme(qapp, "windows")

    # 3. Dark and Light presets
    apply_theme(qapp, "dark")
    apply_theme(qapp, "light")

    # 4. Unknown/invalid style handled gracefully without raising
    apply_theme(qapp, "nonexistent_custom_theme_12345")


def test_main_dry_run_with_theme(qapp: QApplication) -> None:
    """Verify that main with --theme initializes and returns 0 in dry-run mode."""
    exit_code = main(["--dry-run", "--theme", "dark"])
    assert exit_code == 0


def test_main_constants_and_all_exports() -> None:
    """Verify application identity constants and module exports."""
    assert APPLICATION_NAME == "CoChem-Studio"
    assert APPLICATION_DISPLAY_NAME == "CoChem-Studio"
    assert APPLICATION_VERSION == "0.1.0"
    assert ORGANIZATION_NAME == "CoChem"
    assert ORGANIZATION_DOMAIN == "cochem.org"
